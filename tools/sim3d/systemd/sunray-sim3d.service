[Unit]
Description=Sunray cloud 3D simulator (config_sim_ws.h)
Wants=sunray-sim3d-world.service network-online.target
After=sunray-sim3d-world.service network-online.target

[Service]
User=orangepi
SupplementaryGroups=render
WorkingDirectory=/home/orangepi/Sunray-sim3d/linux
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/stdbuf -oL -eL /home/orangepi/Sunray-sim3d/linux/build-sim3d/sunray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
